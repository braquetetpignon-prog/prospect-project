# Gabarit de référence — à copier dans les variables d'environnement de
# chaque app Coolify (dev/prod). Ce fichier ne contient AUCUNE vraie valeur,
# ne jamais y mettre de secret réel avant de le committer.

# --- Environnement --------------------------------------------------------
# local / preproduction / production — "local" désactive les cookies
# "secure" et le HSTS, car le docker-compose local sert en HTTP sans TLS.
ENV=local

# --- Base de données -------------------------------------------------------
# URL de connexion PostgreSQL complète (psycopg2), lue une seule fois au
# démarrage — pas de rechargement à chaud. Format :
# postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/clickprospect

# --- Sécurité / session -----------------------------------------------------
# Clé de signature des cookies de session Flask. Longue chaîne aléatoire,
# unique par environnement, jamais réutilisée entre dev et prod.
SECRET_KEY=change-me

# Clé de chiffrement Fernet pour les identifiants SMTP client stockés en
# base (cryptography.Fernet). Générer avec :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SMTP_ENCRYPTION_KEY=change-me

# --- Compte superadmin -------------------------------------------------------
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me

# --- URL de base de l'application -------------------------------------------
# Utilisée pour construire les liens absolus dans les emails système
# (vérification, réinitialisation de mot de passe, etc.)
APP_BASE_URL=https://clickprospect.fr

# --- Email système (SMTP applicatif, distinct du SMTP client workspace) ----
SYSTEM_SMTP_HOST=smtp.example.com
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USERNAME=change-me
SYSTEM_SMTP_PASSWORD=change-me
SYSTEM_SMTP_FROM_EMAIL=no-reply@clickprospect.fr

# --- Intégrations tierces ---------------------------------------------------
# Paiement Mollie — clé test en dev, clé live en prod
MOLLIE_API_KEY=change-me

# IA (recherche/assistant) — modèle Gemini
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-1.5-flash

# --- Divers / maintenance ---------------------------------------------------
# Intervalle en secondes entre deux passages du scheduler (relances,
# purges RGPD, emails lifecycle, etc.)
SCHEDULER_INTERVAL_SECONDS=3600

# Durée de rétention (jours) de l'historique de consentement RGPD
CONSENT_HISTORY_RETENTION_DAYS=365

# Chemin surveillé pour le monitoring d'espace disque du VPS
VPS_MONITORING_DISK_PATH=/

# --- Renseigné automatiquement par le pipeline de build (ne pas définir à
# la main) : hash du commit affiché dans le badge de version --------------
GIT_COMMIT=
